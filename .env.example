# ---------------------------------------------------------------------------
# Madar NRCS - environment configuration (copy to .env and adjust)
# ---------------------------------------------------------------------------

# development | production
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Where the SQLite database and its backups live. Mount a persistent volume here.
DATA_DIR=./data

# Public URL of the deployment (informational).
APP_URL=https://newsroom.example.com

# Set when running behind a reverse proxy / load balancer (e.g. 1 or "loopback").
# Needed for correct client IPs in audit logs and rate limiting.
TRUST_PROXY=1

# --- Initial administrator (only used when the database has no accounts yet) ---
ADMIN_EMAIL=admin@example.com
# At least 10 characters with letters and digits. If omitted, a random password is
# generated, printed once in the server log, and must be changed at first login.
ADMIN_PASSWORD=
ADMIN_NAME=مدير النظام

# --- Sessions ---
SESSION_TTL_HOURS=12
# Secure cookies require HTTPS. Defaults to true in production; set to false only
# for plain-HTTP intranet deployments.
COOKIE_SECURE=true

# --- Data & administration ---
# Demo newsroom content and demo accounts (shared password). NEVER enable in production.
SEED_DEMO_DATA=false
DEMO_USER_PASSWORD=Madar@Demo2026
# Read-only SQL console for super admins (default: off in production).
ENABLE_SQL_CONSOLE=false
# Allow wiping content from the UI (default: off in production).
ALLOW_DB_RESET=false
# Automatic online backups (0 disables) and how many backup files to keep.
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION=20

# --- Newsroom working set ---
# Finished news (published/archived/withdrawn/rejected) untouched for this many days is no longer
# downloaded by every browser; it stays searchable in "الأرشيف القديم". 0 syncs everything.
NEWS_ACTIVE_DAYS=90

# --- Agency wire feeds (RSS/Atom URLs are set per source in Settings) ---
# Poll interval in minutes (0 disables polling) and how long wire items are kept.
WIRE_POLL_MINUTES=5
WIRE_RETENTION_DAYS=3
# Feeds on internal/private addresses are blocked (SSRF protection) unless enabled.
WIRE_ALLOW_PRIVATE_HOSTS=false

# --- Data retention (days; 0 keeps forever). Cleanup runs hourly. ---
# Trashed news/stories/programs/episodes/guests/media are purged after this many days.
TRASH_RETENTION_DAYS=30
# Notifications (read ones after at most 30 days).
NOTIFICATION_RETENTION_DAYS=90
# Activity log and internal chat messages.
LOG_RETENTION_DAYS=365
# Security audit log (kept forever by default).
AUDIT_LOG_RETENTION_DAYS=0

# --- Media uploads (stored in DATA_DIR/uploads; back this folder up with the database) ---
MEDIA_MAX_UPLOAD_MB=500

# --- Protection ---
RATE_LIMIT_PER_MINUTE=600
LOGIN_RATE_LIMIT_PER_15MIN=20
LOG_LEVEL=info

# --- AI co-pilot (optional). Without a key the editor falls back to fixed templates. ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Time zone of the newsroom (used for scheduled bulletins, booking times in e-mails) ---
# TZ=Asia/Riyadh

# --- Notification delivery by e-mail and phone/desktop push (each colleague picks what they
# receive in "تنبيهاتي"). Leave SMTP_HOST empty to disable e-mail. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Madar NRCS <newsroom@example.com>"
# Web Push needs HTTPS (APP_URL) in production. Keys are generated and kept in the database
# unless you set them (generate with: npx web-push generate-vapid-keys).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:newsroom@example.com
# Seconds between delivery runs (0 disables e-mail/push delivery).
NOTIFY_DELIVERY_SECONDS=15
