# ---------------------------------------------------------------------------
# Madar NRCS - environment configuration (copy to .env and adjust)
# ---------------------------------------------------------------------------

# development | production
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Where the SQLite database and its backups live. Mount a persistent volume here.
DATA_DIR=./data

# Public HTTPS address of the deployment. Links in e-mails and push notifications point here;
# the server warns in «مراقبة النظام» when it is missing in production.
APP_URL=https://newsroom.example.com

# Reverse proxy: ONLY set this when every request really comes through your proxy (Caddy, nginx,
# a load balancer) and the app port is not reachable directly. With TRUST_PROXY set and the port
# open to the network, anyone can forge X-Forwarded-For: bypass the login rate limits and write
# false IP addresses into the audit log. Use 1 for one proxy in front, or "loopback" when the proxy
# runs on the same machine (docker-compose below binds the app to 127.0.0.1 for that case).
# TRUST_PROXY=loopback

# --- Initial administrator (only used when the database has no accounts yet) ---
ADMIN_EMAIL=admin@example.com
# At least 10 characters with letters and digits. If omitted, a random password is
# generated and printed once in the server log. Either way it must be changed at first
# sign-in; remove ADMIN_PASSWORD from this file afterwards (it is plain text on disk).
ADMIN_PASSWORD=
ADMIN_NAME=مدير النظام

# --- Sessions ---
SESSION_TTL_HOURS=12
# A temporary password issued by an administrator stops working after this many hours.
TEMP_PASSWORD_HOURS=72
# Secure cookies require HTTPS (a browser never sends them over plain http to another machine,
# so sign-in fails). Keep true and put the app behind HTTPS; false only for a plain-HTTP intranet,
# which the server reports as a deployment warning.
COOKIE_SECURE=true

# --- Data & administration ---
# Demo newsroom content and demo accounts (shared, published password). NEVER enable in production:
# with NODE_ENV=production the server refuses to start with SEED_DEMO_DATA=true unless
# ALLOW_DEMO_IN_PRODUCTION=true (for a public demo server only).
SEED_DEMO_DATA=false
# ALLOW_DEMO_IN_PRODUCTION=false
# DEMO_USER_PASSWORD=change-me-2026
# Read-only SQL console for super admins (default: off in production).
ENABLE_SQL_CONSOLE=false
# Allow wiping content from the UI (default: off in production).
ALLOW_DB_RESET=false
# Automatic online backups (0 disables) and how many backup files to keep.
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION=20
# External folder for the full backup bundles (database + uploads + SHA-256 manifest): a separate
# disk, a mounted network share or a UNC path, outside DATA_DIR. docker-compose mounts the
# «nrcs-backups» volume at /backups for this.
BACKUP_DIRECTORY=/backups
# Optional configured rclone destination, e.g. newsroom-s3:backups/madar.
# The Docker image does not contain rclone: build an image that adds it (and mount its config
# outside the source tree), otherwise every scheduled backup fails at the upload step.
BACKUP_REMOTE=

# --- Newsroom working set ---
# Finished news (published/archived/withdrawn/rejected) untouched for this many days is no longer
# downloaded by every browser; it stays searchable in "الأرشيف القديم". 0 syncs everything.
NEWS_ACTIVE_DAYS=90

# --- Agency wire feeds (RSS/Atom URLs are set per source in Settings) ---
# Poll interval in minutes (0 disables polling) and how long wire items are kept.
WIRE_POLL_MINUTES=5
WIRE_RETENTION_DAYS=3
# Feeds on internal/private addresses are blocked (SSRF protection) unless enabled.
WIRE_ALLOW_PRIVATE_HOSTS=false

# --- Data retention (days; 0 keeps forever). Cleanup runs hourly. ---
# Trashed news/stories/programs/episodes/guests/media are purged after this many days.
TRASH_RETENTION_DAYS=30
# Notifications (read ones after at most 30 days).
NOTIFICATION_RETENTION_DAYS=90
# Activity log and internal chat messages.
LOG_RETENTION_DAYS=365
# Security audit log (kept forever by default).
AUDIT_LOG_RETENTION_DAYS=0

# --- Media uploads (stored in DATA_DIR/uploads; back this folder up with the database) ---
MEDIA_MAX_UPLOAD_MB=500

# --- Protection ---
RATE_LIMIT_PER_MINUTE=600
LOGIN_RATE_LIMIT_PER_15MIN=20
LOG_LEVEL=info

# --- Editorial AI (optional). Keep these keys on the server. ---
# Leave empty to prefer Gemini, then OpenAI, then OpenRouter when configured.
AI_DEFAULT_PROVIDER=
# Daily external AI requests per account, reset at midnight UTC. A role limit of 0 disables sending for that role.
AI_DAILY_REQUESTS=120
# AI_DAILY_REQUESTS_BY_ROLE={"EDITOR":160,"TRAINEE":0}
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Update checks use the official GitHub repository. A private repository needs Contents: read.
# manual = check and refresh the browser; github = dispatch a deployment workflow; webhook = signed request.
UPDATE_MODE=manual
UPDATE_GITHUB_TOKEN=
UPDATE_GITHUB_WORKFLOW=
UPDATE_WEBHOOK_URL=
UPDATE_WEBHOOK_SECRET=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini

# --- Time zone of the server process: logs, scheduled jobs, times in e-mails. Set it to the
# station's zone (the same as «المنطقة الزمنية» in the settings; quiet hours already follow that
# setting). Without TZ the container runs on UTC and «مراقبة النظام» shows a warning. ---
TZ=Asia/Riyadh

# --- Notification delivery by e-mail and phone/desktop push (each colleague picks what they
# receive in "تنبيهاتي"). Leave SMTP_HOST empty to disable e-mail. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Madar NRCS <newsroom@example.com>"
# Web Push needs HTTPS (APP_URL) in production. Keys are generated and kept in the database
# unless you set them (generate with: npx web-push generate-vapid-keys).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:newsroom@example.com
# Seconds between delivery runs (0 disables e-mail/push delivery).
NOTIFY_DELIVERY_SECONDS=15

# --- Storage: Dropbox, Google Drive and the station's shared folder (SMB) ---
# Usually connected from «الإعدادات ← التخزين» (keys stay on the server, never in the browser).
# Setting them here instead locks them from the settings screen.
# DROPBOX_APP_KEY=
# DROPBOX_APP_SECRET=
# DROPBOX_REFRESH_TOKEN=
# GDRIVE_CLIENT_ID=
# GDRIVE_CLIENT_SECRET=
# GDRIVE_REFRESH_TOKEN=
# Google sends the administrator back to APP_URL/api/v1/storage/gdrive/callback: register that
# address in the Google Cloud OAuth client.
# When the shared folder is mounted on this server, the server writes to it directly
# (otherwise run «جسر مدار», bridge/madar-bridge.mjs, on a computer inside the network):
# SHARE_DIRECTORY=/mnt/news
# Seconds between copy runs (0 disables copying).
STORAGE_SYNC_SECONDS=20
