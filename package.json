{
  "name": "madar-nrcs",
  "private": true,
  "version": "4.8.2",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist-server/server.cjs",
    "start": "node dist-server/server.cjs",
    "preview": "vite preview",
    "clean": "node -e \"for (const dir of ['dist', 'dist-server']) require('node:fs').rmSync(dir, { recursive: true, force: true })\"",
    "lint": "npm run typecheck && biome lint src",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.strict.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm test && npm run build",
    "bench:newsroom": "tsx scripts/bench-newsroom.ts",
    "release:version": "node scripts/set-release-version.mjs",
    "test:e2e": "npm run build && node tests/e2e/run-isolated.mjs",
    "test:e2e:offline-air": "npm run build && playwright test tests/e2e/offline-air-shell.spec.ts",
    "test:e2e:work-controls": "node tests/e2e/run-isolated.mjs --config playwright.work-controls.config.ts"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.4",
    "@google/genai": "^2.32.0",
    "@xyflow/react": "^13.0.3",
    "better-sqlite3": "^13.2.0",
    "compression": "^1.8.2",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "fast-xml-parser": "^5.12.1",
    "nodemailer": "^10.6.1",
    "pg": "^8.23.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.2",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "^4.14.1",
    "docx": "^9.16.0",
    "dompurify": "^3.5.0",
    "esbuild": "^0.28.2",
    "jszip": "^3.10.2",
    "lucide-react": "^1.80.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "supertest": "^7.3.2",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  },
  "description": "Madar NRCS - broadcast newsroom and program rundown management system",
  "engines": {
    "node": ">=22.12.0"
  }
}
